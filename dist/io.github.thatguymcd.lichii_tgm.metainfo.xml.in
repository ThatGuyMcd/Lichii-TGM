<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@LICHII_TGM_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>@LICHII_TGM_RELEASE_TAG@</name>
  <summary>Experimental Nintendo Switch and Switch 2 emulator</summary>
  <description>
    <p>Lichii-tgm is an experimental open-source emulator fork based on Lichii, Eglantine and Eden, with work inherited from yuzu and Sudachi. Compatibility and performance vary by game and hardware.</p>
  </description>
  <launchable type="desktop-id">@LICHII_TGM_APP_ID@.desktop</launchable>
  <provides><binary>lichii-tgm</binary></provides>
  <categories><category>Game</category><category>Emulator</category></categories>
  <url type="homepage">https://github.com/@LICHII_TGM_REPOSITORY@</url>
  <url type="bugtracker">https://github.com/@LICHII_TGM_REPOSITORY@/issues</url>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>ThatGuyMcd and contributors</developer_name>
  <releases><release version="@LICHII_TGM_VERSION@" date="2026-11-09"/></releases>
  <content_rating type="oars-1.0"/>
</component>
