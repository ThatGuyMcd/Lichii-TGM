#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LICHII_TGM_WINDOWS_VERSION@
 PRODUCTVERSION @LICHII_TGM_WINDOWS_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ThatGuyMcd and contributors\0"
            VALUE "FileDescription", "@LICHII_TGM_RELEASE_TAG@ Nintendo Switch emulator\0"
            VALUE "FileVersion", "@LICHII_TGM_VERSION@\0"
            VALUE "ProductName", "@LICHII_TGM_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@LICHII_TGM_VERSION@\0"
            VALUE "Comments", "https://github.com/@LICHII_TGM_REPOSITORY@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
